local TabGeneral = CreateTab("🎯 Общее")

CreateToggle(TabGeneral, "ESP (Ролевой: Мурдер-Красный, Шериф-Синий)", function(v)
    _G.GeneralESP = v
    task.spawn(function()
        while _G.GeneralESP do
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local h = p.Character:FindFirstChild("QuuuaRoleESP")
                    if not h then
                        h = Instance.new("Highlight", p.Character)
                        h.Name = "QuuuaRoleESP"
                    end
                    
                    local hasKnife = p.Backpack:FindFirstChild("Knife") or p.Character:FindFirstChild("Knife")
                    local hasGun = p.Backpack:FindFirstChild("Gun") or p.Character:FindFirstChild("Gun")
                    
                    if hasKnife then
                        h.FillColor = Color3.fromRGB(240, 50, 50)
                    elseif hasGun then
                        h.FillColor = Color3.fromRGB(60, 150, 255)
                    else
                        h.FillColor = Color3.fromRGB(50, 215, 110)
                    end
                end
            end
            task.wait(0.5)
        end
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local h = p.Character:FindFirstChild("QuuuaRoleESP")
                if h then h:Destroy() end
            end
        end
    end)
end)

